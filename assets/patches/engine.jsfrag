/* antigravity-i18n:begin */
/**
 * Locale-neutral DOM translation engine.
 *
 * This file contains no language data. Everything locale specific -- the
 * dictionary, the dynamic patterns, punctuation mapping, plural rules, writing
 * direction and <html lang> -- is injected as LOCALE_DATA when the fragment is
 * built, so adding a language means adding a JSON file under assets/locales/
 * rather than editing this logic.
 *
 * The antigravity-i18n:begin/end sentinels delimit this whole block so a re-run
 * replaces it exactly. Locating it by a code identifier instead would leave the
 * leading comment behind and grow the file on every run.
 */
const AG_LOCALE = LOCALE_DATA_PLACEHOLDER;
const agText = new Map(Object.entries(AG_LOCALE.text || {}));
const agTranslatedLabels = new Set(agText.values());
const agCompleteSentences = new Set();
for (const [source, target] of agText) {
    if (/[.!?。！？]$/.test(source.trim())) {
        agCompleteSentences.add(source.trim().replace(/\s+/g, ' '));
        if (/[.!?。！？]$/.test(target.trim())) {
            agCompleteSentences.add(target.trim().replace(/\s+/g, ' '));
        }
    }
}
const agPunctuation = AG_LOCALE.punctuation || {};
const agPunctuationSkip = AG_LOCALE.punctuationSkipSuffixes || [];
const agValueMaps = AG_LOCALE.valueMaps || {};
const agInlineMessages = AG_LOCALE.inlineMessages || [];
const agTextState = new WeakMap();
const agAttributeState = new WeakMap();
const agInlineTextNodes = new WeakSet();
const agInlineSlots = new WeakSet();
const agInlineLiteralSlots = new WeakSet();
const agInlineContainers = new WeakMap();

function agSourceText(node) {
    const state = agTextState.get(node);
    return state && node.nodeValue === state.output ? state.source : node.nodeValue;
}

function agWriteText(node, source, output) {
    agTextState.set(node, { source, output });
    if (node.nodeValue !== output) {
        node.nodeValue = output;
    }
}

function agHasInlineSlotAncestor(element, literalOnly = false) {
    const slots = literalOnly ? agInlineLiteralSlots : agInlineSlots;
    for (let current = element; current; current = current.parentElement) {
        if (slots.has(current)) {
            return true;
        }
    }
    return false;
}

// Replacement text is inserted literally. String.prototype.replace still
// interprets $&, $\u0060, $', $n and $$ inside the replacement even when the
// pattern is a plain string, so a translation containing a dollar sign would
// otherwise splice the English source back in or silently drop characters.
function agSpliceLiteral(value, needle, replacement) {
    const at = value.indexOf(needle);
    if (at < 0) {
        return value;
    }
    return value.slice(0, at) + replacement + value.slice(at + needle.length);
}

// Plural category selection, used by patterns whose template varies with a
// count. Intl.PluralRules knows the CLDR categories for the target language,
// so a locale only supplies the forms it actually needs.
const agPluralSelector = (() => {
    const code = AG_LOCALE.pluralLocale || AG_LOCALE.language;
    try {
        const rules = new Intl.PluralRules(code);
        return (count) => rules.select(count);
    } catch {
        return (count) => (count === 1 ? 'one' : 'other');
    }
})();

/**
 * Choose the plural form of a template for a given count.
 *
 * A rule may declare 'templates' as a category map ({ one, few, other, ... }).
 * The exact CLDR category wins; '=N' exact-value keys win over categories; and
 * 'other' is the required fallback so a missing category can never render as
 * an empty string.
 */
function agSelectTemplate(rule, match) {
    if (!rule.templates) {
        return rule.template;
    }
    const raw = match[rule.pluralGroup];
    const count = Number(String(raw === undefined || raw === null ? '' : raw).replace(/[\s,\u00A0\u202F]/g, ''));
    if (!Number.isFinite(count)) {
        return rule.templates.other || rule.template;
    }
    const exact = rule.templates['=' + count];
    if (typeof exact === 'string') {
        return exact;
    }
    const category = agPluralSelector(count);
    if (typeof rule.templates[category] === 'string') {
        return rule.templates[category];
    }
    return rule.templates.other || rule.template;
}

// Compiled once: each entry pairs a matcher with its output template so the
// match test and the substitution can never drift apart (the previous hand
// written version duplicated all 12 regexes across two functions).
const agPatterns = (AG_LOCALE.patterns || []).map((rule) => ({
    id: rule.id,
    regex: new RegExp(rule.pattern, rule.flags || ''),
    template: rule.template,
    templates: rule.templates || null,
    pluralGroup: rule.pluralGroup || 1,
    replace: rule.replace || {},
    trimGroups: rule.trimGroups || [],
}));

const agValueRules = Object.fromEntries(
    Object.entries(AG_LOCALE.valueRules || {}).map(([name, rules]) => [
        name,
        rules.map((r) => ({ regex: new RegExp(r.pattern, r.flags || 'g'), template: r.template })),
    ])
);

const agAttributeNames = ['aria-label', 'title', 'placeholder', 'data-tooltip', 'alt'];
const agContentSelector = [
    // Antigravity 2.15 uses its own file viewer and message containers rather
    // than Monaco or role=log for these surfaces. Their text is user content.
    '.file-viewer-root',
    '[data-testid="user-input-step"]',
    '[data-testid="planner-response-text"]',
    '[data-testid="progress-update-response-text"]',
    // Side-question follow-ups are the user's own text, same as the main composer.
    '[data-testid="side-question-followup-user"]',
    '[data-testid="side-question-question"] > .truncate',
    // Antigravity 2.29 renders spoken replies one word per <span> for live
    // highlighting. These are conversation content, even when a word or a
    // complete utterance happens to equal a UI label such as "Run".
    '[data-testid="transcript-line-text"]',
    '[data-testid="live-user-turn"]',
    '[data-testid="live-agent-turn"]',
    '[data-testid="live-lead"]',
    '[data-testid="live-body"]',
    '[data-testid="voice-transcript-summary-lead"]',
    '[data-testid="voice-transcript-summary-point"]',
    '[translate="no"]',
    '.notranslate',
].join(',');
const agSkipSelector = [
    'script',
    'style',
    'select',
    'code',
    'pre',
    'kbd',
    'samp',
    '[role="textbox"]',
    '[role="log"]',
    '[role="terminal"]',
    '.monaco-editor',
    '.xterm',
    agContentSelector,
].join(',');

const agControlSelector = 'button, input, textarea, select, [role="button"], [role="menuitem"], [role="option"], [role="tab"]';

function agNormalizeInline(value) {
    return String(value).trim().replace(/\s+/g, ' ');
}

// Match only an explicitly named UI container and its complete source. Slots
// retain existing inline elements or provider-name text nodes. Every other
// element makes the shape ineligible, including arbitrary nested content.
function agMatchInlineMessage(element, rule) {
    const groups = [[]];
    const slots = [];
    let source = '';
    const children = Array.from(element.childNodes);
    for (let index = 0; index < children.length; index++) {
        const node = children[index];
        const spec = rule.slots[slots.length];
        const slotMatches = spec && (spec.selector
            ? node.nodeType === Node.ELEMENT_NODE && node.matches(spec.selector)
            : index === spec.textIndex && node.nodeType === Node.TEXT_NODE);
        if (slotMatches) {
            if (node.nodeType === Node.ELEMENT_NODE && node.childElementCount !== 0) {
                return null;
            }
            const texts = node.nodeType === Node.TEXT_NODE ? [] : Array.from(node.childNodes).filter(child => child.nodeType === Node.TEXT_NODE);
            if (spec.text) {
                const original = texts.map(agSourceText).join('');
                if (agNormalizeInline(original) !== agNormalizeInline(spec.text) &&
                    agNormalizeInline(node.textContent) !== agNormalizeInline(translateString(spec.text))) {
                    return null;
                }
            }
            slots.push({ node, spec, texts: texts.map(child => ({ node: child, source: agSourceText(child) })) });
            source += '{' + slots.length + '}';
            groups.push([]);
        } else if (node.nodeType === Node.TEXT_NODE) {
            const original = agSourceText(node) || '';
            groups[groups.length - 1].push({ node, source: original });
            source += original;
        } else if (node.nodeType !== Node.COMMENT_NODE) {
            return null;
        }
    }
    if (slots.length !== rule.slots.length || agNormalizeInline(source) !== agNormalizeInline(rule.source)) {
        return null;
    }
    const segments = rule.template.split(/\{\d+\}/);
    if (segments.some((segment, index) => segment !== '' && groups[index].length === 0)) {
        return null;
    }
    return { groups, slots, segments };
}

function agReleaseInlineMessage(element, restore) {
    const state = agInlineContainers.get(element);
    if (!state) {
        return;
    }
    for (const node of state.texts) {
        const prior = agTextState.get(node);
        if (restore && prior && node.nodeValue === prior.output) {
            node.nodeValue = prior.source;
        }
        agTextState.delete(node);
        agInlineTextNodes.delete(node);
    }
    for (const node of state.slots) {
        agInlineSlots.delete(node);
        agInlineLiteralSlots.delete(node);
    }
    agInlineContainers.delete(element);
}

function agTranslateInlineMessage(element) {
    if (!agInlineMessages.length || isSkippableElement(element)) {
        return false;
    }
    for (const rule of agInlineMessages) {
        if (!element.matches(rule.selector)) {
            continue;
        }
        const match = agMatchInlineMessage(element, rule);
        if (!match) {
            continue;
        }
        agReleaseInlineMessage(element, false);
        const texts = [];
        const slots = [];
        match.groups.forEach((group, index) => group.forEach((entry, part) => {
            agWriteText(entry.node, entry.source, part === 0 ? match.segments[index] : '');
            agInlineTextNodes.add(entry.node);
            texts.push(entry.node);
        }));
        for (const slot of match.slots) {
            slots.push(slot.node);
            agInlineSlots.add(slot.node);
            if (slot.spec.text) {
                const translated = translateString(slot.spec.text);
                slot.texts.forEach((entry, index) => {
                    agWriteText(entry.node, entry.source, index === 0 ? translated : '');
                    texts.push(entry.node);
                });
            } else {
                agInlineLiteralSlots.add(slot.node);
            }
        }
        agInlineContainers.set(element, { texts, slots });
        return true;
    }
    // If React changes a previously handled UI into an unknown sentence,
    // restore unchanged source nodes rather than mixing old translated pieces
    // with the new text. Nodes actually updated by React are left as supplied.
    agReleaseInlineMessage(element, true);
    return false;
}

function agTranslateInlineAncestors(element) {
    if (!agInlineMessages.length || element?.closest(agContentSelector) || element?.isContentEditable) {
        return;
    }
    for (let current = element; current; current = current.parentElement) {
        agTranslateInlineMessage(current);
    }
}

// A text-node match is not necessarily a complete label. React and inline
// markup can split an untranslated sentence into nodes like "Open" +
// " the folder". Keep such runs in English instead of replacing a fragment.
// Separate controls and flex/grid items remain independent UI labels.
function isSentenceWithIndependentLink(before, after) {
    if (before.nodeType !== Node.TEXT_NODE || after.nodeType !== Node.ELEMENT_NODE || after.tagName !== 'A') {
        return false;
    }
    const sentence = (before.nodeValue || '').trim().replace(/\s+/g, ' ');
    const label = (after.textContent || '').trim().replace(/\s+/g, ' ');
    return agCompleteSentences.has(sentence) && Boolean(agLookup(label) || agTranslatedLabels.has(label));
}

function isKnownCompleteSentence(node) {
    if (node.nodeType !== Node.TEXT_NODE &&
        !(node.nodeType === Node.ELEMENT_NODE && node.matches('strong, b') && node.childElementCount === 0)) {
        return false;
    }
    const original = node.nodeType === Node.TEXT_NODE ? agSourceText(node) : node.textContent;
    const text = (original || '').trim().replace(/\s+/g, ' ');
    return agCompleteSentences.has(text) || (/[.!?。！？]$/.test(text) && hasTranslation(text));
}

const agTooltipShortcutRe = /^(?:(?:(?:Ctrl|Alt|Shift|Cmd|Control|Option|Command|Meta)\+)+|[⌃⌥⇧⌘]+)(?:[A-Z0-9\[\]\\;',./`=+\-←→↑↓↵⌫⌦⎋⇥]|F(?:[1-9]|1\d|2[0-4])|Enter|Return|Escape|Esc|Tab|Space|Backspace|Delete|Home|End|PageUp|PageDown|Arrow(?:Up|Down|Left|Right))$/;
function isTooltipShortcutSpan(element) {
    return element?.nodeType === Node.ELEMENT_NODE && element.tagName === 'SPAN' &&
        element.childElementCount === 0 && element.closest('[role="tooltip"]') &&
        agTooltipShortcutRe.test((element.textContent || '').trim());
}

function isTooltipLabelWithShortcut(before, after) {
    if (!isTooltipShortcutSpan(after) ||
        !(before.nodeType === Node.TEXT_NODE || (before.nodeType === Node.ELEMENT_NODE && before.tagName === 'SPAN' && before.childElementCount === 0))) {
        return false;
    }
    const label = (before.textContent || '').trim().replace(/\s+/g, ' ');
    return Boolean(agLookup(label) || agTranslatedLabels.has(label));
}

function hasInlineSiblingText(node, direction) {
    for (let sibling = node[direction]; sibling; sibling = sibling[direction]) {
        // A complete, known settings sentence can be followed by a separate
        // help link. Recognize both source and translated text so either side
        // can update after the other has already been localized.
        const before = direction === 'previousSibling' ? sibling : node;
        const after = direction === 'previousSibling' ? node : sibling;
        if (isSentenceWithIndependentLink(before, after) ||
            (isKnownCompleteSentence(before) && isKnownCompleteSentence(after)) ||
            isTooltipLabelWithShortcut(before, after)) {
            continue;
        }
        if (sibling.nodeType === Node.TEXT_NODE) {
            if (/[A-Za-z]/.test(sibling.nodeValue || '')) {
                return true;
            }
            continue;
        }
        if (sibling.nodeType !== Node.ELEMENT_NODE) {
            continue;
        }
        if (sibling.matches('[aria-hidden="true"], svg')) {
            continue;
        }
        const display = getComputedStyle(sibling).display;
        if (display === 'none') {
            continue;
        }
        if ((display !== 'inline' && display !== 'contents') || sibling.matches(agControlSelector)) {
            break;
        }
        if (/[A-Za-z]/.test(sibling.textContent || '')) {
            return true;
        }
    }
    return false;
}

function isSentenceFragment(node) {
    for (let current = node; current.parentElement; current = current.parentElement) {
        const parent = current.parentElement;
        const display = getComputedStyle(parent).display;
        if (display.includes('flex') || display.includes('grid')) {
            return false;
        }
        if (hasInlineSiblingText(current, 'previousSibling') || hasInlineSiblingText(current, 'nextSibling')) {
            return true;
        }
        if ((display !== 'inline' && display !== 'contents') || parent.matches(agControlSelector)) {
            return false;
        }
    }
    return false;
}

/**
 * Expand {n} placeholders in a template using regex capture groups.
 *
 * A group listed in rule.replace is first mapped through a named value map
 * (for example the duration unit 's' -> the localized 'seconds'), falling back
 * to the raw captured text when the map has no entry.
 *
 * @param {string} template
 * @param {RegExpMatchArray} match
 * @param {object} rule
 * @returns {string}
 */
function agFormat(template, match, rule) {
    return String(template).replace(/\{(\d+)\}/g, (_, index) => {
        const groupIndex = Number(index);
        let captured = match[groupIndex];
        if (captured === undefined || captured === null) {
            return '';
        }
        if (rule.trimGroups.includes(groupIndex)) {
            captured = String(captured).trim();
        }
        const mapName = rule.replace[groupIndex] || rule.replace[index];
        if (!mapName) {
            return captured;
        }
        const valueRule = agValueRules[mapName];
        if (valueRule) {
            let text = String(captured);
            for (const step of valueRule) {
                text = text.replace(step.regex, (...args) => agFormat(step.template, args, { replace: {}, trimGroups: [] }));
            }
            return text;
        }
        const map = agValueMaps[mapName];
        if (!map) {
            return captured;
        }
        const key = String(captured);
        if (Object.prototype.hasOwnProperty.call(map, key)) {
            return map[key];
        }
        const lower = key.toLowerCase();
        if (Object.prototype.hasOwnProperty.call(map, lower)) {
            return map[lower];
        }
        return captured;
    });
}

/**
 * Find the dynamic rule that matches a string, if any.
 *
 * @param {string} trimmed
 * @returns {{ rule: object, match: RegExpMatchArray }|null}
 */
function agMatchPattern(trimmed) {
    for (const rule of agPatterns) {
        const match = trimmed.match(rule.regex);
        if (match) {
            return { rule, match };
        }
    }
    return null;
}

function agLookup(trimmed) {
    return agText.get(trimmed) || agText.get(trimmed.replace(/\s+/g, ' '));
}

function agSplitTrailingPunctuation(trimmed) {
    const match = trimmed.match(/^([\s\S]*?)([\.\:\：\?\？\!\…\s]+)$/);
    if (!match) {
        return null;
    }
    return { core: match[1].trim(), punctuation: match[2] };
}

function hasTranslation(trimmed) {
    if (agLookup(trimmed)) {
        return true;
    }
    const split = agSplitTrailingPunctuation(trimmed);
    if (split && agText.has(split.core)) {
        return true;
    }
    return agMatchPattern(trimmed) !== null;
}

function translateString(value) {
    if (typeof value !== 'string') {
        return value;
    }
    const trimmed = value.trim();
    if (!trimmed) {
        return value;
    }

    const direct = agLookup(trimmed);
    if (direct) {
        return agSpliceLiteral(value, trimmed, direct);
    }

    const matched = agMatchPattern(trimmed);
    if (matched) {
        const template = agSelectTemplate(matched.rule, matched.match);
        return agSpliceLiteral(value, trimmed, agFormat(template, matched.match, matched.rule));
    }

    // Dictionary hit with trailing punctuation: localize the punctuation too,
    // unless the translation already ends with localized punctuation.
    const split = agSplitTrailingPunctuation(trimmed);
    if (split) {
        const translated = agText.get(split.core);
        if (translated) {
            let punctuation = split.punctuation;
            for (const [from, to] of Object.entries(agPunctuation)) {
                if (punctuation.includes(from)) {
                    punctuation = punctuation.split(from).join(to);
                }
            }
            if (agPunctuationSkip.some((suffix) => translated.endsWith(suffix))) {
                return agSpliceLiteral(value, trimmed, translated);
            }
            return agSpliceLiteral(value, trimmed, translated + punctuation);
        }
    }
    return value;
}

// ---------------------------------------------------------------------------
// DOM traversal layer. Locale neutral: it decides *where* text may be replaced
// and defers *what* to translateString() above.
// ---------------------------------------------------------------------------
function isSkippableElement(element) {
    // isContentEditable covers inherited editability plus values such as an
    // empty attribute or "plaintext-only". Matching only
    // [contenteditable="true"] can rewrite text the user is actively editing.
    return Boolean(element?.isContentEditable || element?.closest?.(agSkipSelector) || agHasInlineSlotAncestor(element) || isTooltipShortcutSpan(element));
}
function shouldTranslateTextNode(node) {
    if (agInlineTextNodes.has(node) || agInlineSlots.has(node)) {
        return false;
    }
    const state = agTextState.get(node);
    if (state) {
        if (node.nodeValue === state.output) {
            return false;
        }
        agTextState.delete(node);
    }
    const parent = node.parentElement;
    if (!parent || isSkippableElement(parent)) {
        return false;
    }
    if (parent.tagName === 'INPUT' || parent.tagName === 'TEXTAREA') {
        return false;
    }
    const trimmed = node.nodeValue?.trim();
    if (!trimmed || !hasTranslation(trimmed)) {
        return false;
    }
    return !isSentenceFragment(node);
}
function translateAttributes(root) {
    if (root.nodeType !== Node.ELEMENT_NODE) {
        return;
    }
    const element = root;
    // Editors can expose UI labels, while conversation/file content may carry
    // user-supplied Markdown titles or image alt text. Preserve those too,
    // including when a nested node is inserted or its attributes change later.
    if (element.matches('script, style') || element.closest(agContentSelector) || agHasInlineSlotAncestor(element, true)) {
        return;
    }
    let outputs = agAttributeState.get(element);
    for (const attr of agAttributeNames) {
        const current = element.getAttribute(attr);
        // A translation can itself be an English lookup key, as with the
        // German Quota -> Quote. Keep the engine's own output on this element.
        if (outputs?.get(attr) === current) {
            continue;
        }
        const next = translateString(current);
        if (next === current) {
            outputs?.delete(attr);
            continue;
        }
        if (!outputs) {
            outputs = new Map();
            agAttributeState.set(element, outputs);
        }
        outputs.set(attr, next);
        element.setAttribute(attr, next);
    }
}
function translateNode(root) {
    if (!root) {
        return;
    }
    if (root.nodeType === Node.TEXT_NODE) {
        agTranslateInlineAncestors(root.parentElement);
        if (shouldTranslateTextNode(root)) {
            const next = translateString(root.nodeValue);
            if (next !== root.nodeValue) {
                agWriteText(root, root.nodeValue, next);
            }
        }
        return;
    }
    if (root.nodeType !== Node.ELEMENT_NODE) {
        return;
    }
    agTranslateInlineAncestors(root.parentElement);
    if (isSkippableElement(root)) {
        // Preserve user-editable/code text, while still localizing its own
        // labels when the element is inserted with attributes already set.
        translateAttributes(root);
        return;
    }
    agTranslateInlineMessage(root);
    translateAttributes(root);
    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT | NodeFilter.SHOW_ELEMENT, {
        acceptNode(node) {
            if (node.nodeType === Node.ELEMENT_NODE && isSkippableElement(node)) {
                // Skip editable/code descendants, but keep the element's UI
                // attributes (for example, an editor aria-label) localized.
                translateAttributes(node);
                return NodeFilter.FILTER_REJECT;
            }
            return NodeFilter.FILTER_ACCEPT;
        },
    });
    let node = walker.nextNode();
    while (node) {
        if (node.nodeType === Node.TEXT_NODE) {
            if (shouldTranslateTextNode(node)) {
                const next = translateString(node.nodeValue);
                if (next !== node.nodeValue) {
                    agWriteText(node, node.nodeValue, next);
                }
            }
        }
        else {
            agTranslateInlineMessage(node);
            translateAttributes(node);
        }
        node = walker.nextNode();
    }
}
function installLocalePatch() {
    document.documentElement.setAttribute('lang', AG_LOCALE.htmlLang || AG_LOCALE.language);
    // Right-to-left scripts need the document direction as well; without it a
    // fully translated RTL UI still lays out left-to-right.
    if (AG_LOCALE.dir) {
        document.documentElement.setAttribute('dir', AG_LOCALE.dir);
    }
    translateNode(document.documentElement);
    const observer = new MutationObserver((mutations) => {
        for (const mutation of mutations) {
            if (mutation.type === 'characterData') {
                translateNode(mutation.target);
            }
            else if (mutation.type === 'attributes') {
                translateAttributes(mutation.target);
            }
            else {
                // React can remove a conditional fragment without adding any
                // nodes. Re-match the surviving inline container in that case.
                if (mutation.removedNodes.length) {
                    agTranslateInlineAncestors(mutation.target);
                }
                mutation.addedNodes.forEach(translateNode);
            }
        }
    });
    observer.observe(document.documentElement, {
        childList: true,
        subtree: true,
        characterData: true,
        attributes: true,
        attributeFilter: agAttributeNames,
    });
}
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', installLocalePatch, { once: true });
}
else {
    installLocalePatch();
}
/* antigravity-i18n:end */
