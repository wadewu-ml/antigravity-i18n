(function installSessionMetricsReader() {
    let DatabaseSync;
    let isLocalHubTopFrame;
    try {
        ({ isLocalHubTopFrame } = require('./utils'));
        ({ DatabaseSync } = require('node:sqlite'));
    } catch {
        return;
    }
    if (typeof isLocalHubTopFrame !== 'function') return;
    const { app, ipcMain } = require('electron');
    const { stat } = require('node:fs/promises');
    const { join } = require('node:path');
    const idPattern = /^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$/i;
    const recent = new Map();
    const readStat = (file) => stat(file).catch(() => null);
    // Skip oversized records inside SQLite before copying their blobs into JS.
    const recentGenerations = 'SELECT CASE WHEN length(data) <= 16777216 THEN data END AS data '
        + 'FROM gen_metadata ORDER BY idx DESC LIMIT 4';

    function readFields(bytes) {
        const fields = new Map();
        if (!(bytes instanceof Uint8Array)) return fields;
        let offset = 0;
        function varint() {
            let value = 0;
            let scale = 1;
            for (let i = 0; i < 10 && offset < bytes.length; i++) {
                const byte = bytes[offset++];
                value += (byte & 127) * scale;
                if (byte < 128) return value;
                scale *= 128;
            }
            throw new Error('Invalid generation metadata varint');
        }
        while (offset < bytes.length) {
            const key = varint();
            const field = Math.floor(key / 8);
            if (!Number.isSafeInteger(key) || field === 0) throw new Error('Invalid generation metadata field');
            const wire = key % 8;
            if (wire === 0) {
                const value = varint();
                if (Number.isSafeInteger(value)) fields.set(field, value);
                continue;
            }
            const length = wire === 2 ? varint() : wire === 1 ? 8 : wire === 5 ? 4 : -1;
            const end = offset + length;
            if (length < 0 || end > bytes.length) throw new Error('Invalid generation metadata length');
            if (wire === 2) fields.set(field, bytes.subarray(offset, end));
            offset = end;
        }
        return fields;
    }

    function seconds(bytes) {
        if (!(bytes instanceof Uint8Array)) return null;
        const parts = readFields(bytes);
        const secs = parts.get(1) ?? 0;
        const nanos = parts.get(2) ?? 0;
        if (typeof secs !== 'number' || typeof nanos !== 'number' || nanos >= 1e9) return null;
        return secs + nanos / 1e9;
    }

    function decodeMetrics(data) {
        // Decode the usage, context and timing fields of the model call.
        const call = readFields(readFields(data).get(1));
        const usage = readFields(call.get(4));
        const window = readFields(readFields(call.get(9)).get(10));
        const cached = usage.get(5);
        const output = usage.get(3);
        const inputCounts = [usage.get(2), usage.get(4), cached].filter(Number.isSafeInteger);
        const totalInput = inputCounts.length ? inputCounts.reduce((sum, count) => sum + count, 0) : null;
        const estimatedUsed = window.get(1);
        const used = Number.isSafeInteger(estimatedUsed) ? estimatedUsed : totalInput;
        const limit = window.get(4);
        const stream = seconds(call.get(12));
        const firstToken = seconds(call.get(11));
        const elapsed = firstToken !== null && stream !== null ? firstToken + stream : null;
        if (!Number.isSafeInteger(used) && typeof output !== 'number') return null;
        return {
            used: Number.isSafeInteger(used) ? used : null,
            limit: typeof limit === 'number' && limit > 0 ? limit : null,
            speed: typeof output === 'number' && elapsed > 0 ? output / elapsed : null,
            cacheRate: Number.isSafeInteger(totalInput) && totalInput > 0
                ? (Number.isSafeInteger(cached) ? cached : 0) / totalInput : null,
            firstToken,
        };
    }

    async function latestMetrics(id) {
        const databasePath = join(app.getPath('home'), '.gemini', 'antigravity', 'conversations', id + '.db');
        const [dbStat, walStat] = await Promise.all([readStat(databasePath), readStat(databasePath + '-wal')]);
        if (!dbStat?.isFile()) return null;
        const signature = [dbStat.mtimeMs, dbStat.size, walStat?.mtimeMs, walStat?.size].join(':');
        const previous = recent.get(id);
        if (previous?.signature === signature) return previous.metrics;

        const db = new DatabaseSync(databasePath, { readOnly: true });
        let metrics = null;
        try {
            for (const row of db.prepare(recentGenerations).iterate()) {
                try {
                    metrics = decodeMetrics(row.data);
                } catch {
                    // A malformed record can precede a readable older call.
                    continue;
                }
                if (metrics) break;
            }
        } finally {
            db.close();
        }
        recent.delete(id);
        if (recent.size === 32) recent.delete(recent.keys().next().value);
        recent.set(id, { signature, metrics });
        return metrics;
    }

    ipcMain.handle('antigravity-i18n:session-metrics', async (event, id) => {
        if (typeof id !== 'string' || !idPattern.test(id) || !isLocalHubTopFrame(event)) return null;
        try {
            return await latestMetrics(id.toLowerCase());
        } catch {
            // The language server can replace or temporarily lock its database.
            return null;
        }
    });

    // Use the host's local session and certificate trust, just as the Hub does.
    // Keep only in-flight requests: the LS owns the account-aware quota cache.
    let pendingQuota;
    ipcMain.handle('antigravity-i18n:model-quota', async (event) => {
        if (!isLocalHubTopFrame(event)) return null;
        try {
            const host = require('./languageServer');
            const base = new URL(host.getLsBaseUrl());
            if (base.protocol !== 'https:' || base.hostname !== '127.0.0.1' ||
                new URL(event.senderFrame.url).origin !== base.origin) return null;
            const token = host.getLsCsrfToken();
            if (!token) return null;
            if (pendingQuota?.origin === base.origin && pendingQuota.token === token) return pendingQuota.result;
            const result = readQuota(event.sender.session, base.origin, token);
            pendingQuota = { origin: base.origin, token, result };
            try {
                return await result;
            } finally {
                if (pendingQuota?.result === result) pendingQuota = null;
            }
        } catch {
            return null;
        }
    });

    async function readQuota(session, origin, token) {
        try {
            const response = await session.fetch(origin + '/exa.language_server_pb.LanguageServerService/RetrieveUserQuotaSummary', {
                method: 'POST', redirect: 'error', signal: AbortSignal.timeout(8000),
                headers: { 'content-type': 'application/json', 'connect-protocol-version': '1', 'x-codeium-csrf-token': token },
                body: '{}',
            });
            if (!response.ok) return null;
            const summary = (await response.json())?.response;
            if (!summary || (summary.groups != null && !Array.isArray(summary.groups))) return null;
            return (summary.groups ?? []).map((group) => ({
                name: group.displayName || '',
                buckets: (group.buckets ?? []).map((bucket) => ({
                    name: bucket.displayName || bucket.window || '',
                    window: bucket.window || '',
                    fraction: !bucket.disabled && Number.isFinite(bucket.remainingFraction) &&
                        bucket.remainingFraction >= 0 && bucket.remainingFraction <= 1 ? bucket.remainingFraction : null,
                    reset: !bucket.disabled && typeof bucket.resetTime === 'string' ? bucket.resetTime : null,
                })),
            }));
        } catch {
            return null;
        }
    }
})();
