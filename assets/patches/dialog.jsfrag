// These dialogs are owned by the main process, outside the DOM.
(function installLocaleDialogs() {
    const labels = new Map(Object.entries(DIALOG_DATA_PLACEHOLDER));
    const dialog = electron_1.dialog;
    const translate = (value) => labels.has(value) ? labels.get(value) : value;
    for (const method of ['showMessageBox', 'showMessageBoxSync']) {
        const original = dialog[method];
        if (typeof original !== 'function') continue;
        dialog[method] = function (...args) {
            // Preserve both (options) and (window, options) overloads.
            const index = args.length > 1 && args[1] && typeof args[1] === 'object' ? 1 : 0;
            const options = args[index];
            let message;
            if (options?.title === 'Confirm Quit' && options.message === 'Are you sure you want to quit?'
                || options?.title === 'Check for Updates' && options.message === 'No updates available') {
                message = translate(options.message);
            } else if (options?.title === 'WSL distro not found' && options.detail === 'Antigravity opened on Windows instead.') {
                const distro = /^The WSL distro "([\s\S]+)" is no longer installed\.$/.exec(options.message);
                if (distro) {
                    message = translate('The WSL distro "{1}" is no longer installed.').replace('{1}', () => distro[1]);
                }
            }
            if (message !== undefined) {
                args[index] = {
                    ...options,
                    title: translate(options.title),
                    message,
                    detail: translate(options.detail),
                    ...(Array.isArray(options.buttons) ? { buttons: options.buttons.map(translate) } : {}),
                };
            }
            return Reflect.apply(original, this, args);
        };
    }
})();
/* regravity:end */
