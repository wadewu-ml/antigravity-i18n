/* antigravity-i18n:begin */
/**
 * Native application menu translation. Locale neutral: the label map is
 * injected as MENU_DATA when the fragment is built.
 *
 * Delimited by antigravity-i18n:begin/end so a re-run replaces the whole block
 * rather than appending another copy of this comment.
 */
const agMenuLabels = new Map(Object.entries(MENU_DATA_PLACEHOLDER));
function menuLabelMatches(actual, source) {
    return actual === source || actual === agMenuLabels.get(source);
}
function translateMenu(menu) {
    const visit = (item) => {
        const label = item.label;
        if (label && agMenuLabels.has(label)) {
            item.label = agMenuLabels.get(label);
        }
        item.submenu?.items.forEach(visit);
    };
    menu.items.forEach(visit);
}
/* antigravity-i18n:end */
