// The desktop picker mounts its effort submenu only on hover. The selected
// group's React children already describe its native choices.
// Read that group in the renderer world; no Electron API is exposed to the page.
function agMountEffortSliders(labels) {
    const groupSelector = '[data-testid="model-selector-effort-group"]';
    const panelSelector = '[data-testid="model-selector-panel"]';
    function modelSelection(path, activeId) {
        // The picker passes a select-and-dismiss callback down to its submenu.
        // Its own input props still hold the model setter used by the composer.
        const context = path.map(node => node.memoizedProps?.value)
            .find(value => value?.effortIndex instanceof Map && value.selectedModel);
        if (!context) return null;
        const owner = path.map(node => node.memoizedProps).find(props =>
            props?.modelOptions === context.modelOptions && typeof props?.setIsOpen === 'function' &&
            typeof props.setSelectedModel === 'function' && props.setSelectedModel !== context.setSelectedModel);
        if (!owner || !owner.open || owner.lockedReason !== undefined) return null;
        const selected = context.selectedModel;
        for (const options of context.effortIndex.values()) {
            const active = options.get(activeId);
            if (active && (active === selected || (active.modelId && selected.modelId
                ? active.modelId === selected.modelId : active.label === selected.label))) {
                return {options, select:owner.setSelectedModel};
            }
        }
        return null;
    }
    function selection(panel) {
        for (const marker of panel.querySelectorAll(groupSelector)) {
            const key = Object.keys(marker).find(k => k.startsWith('__reactFiber$'));
            if (!key) continue;
            // Both alternates can have a return path to the same root after
            // React reuses children. Walk down the committed tree to read
            // today's choices and callbacks, including on a reused menu.
            const path = [];
            let top = marker[key];
            while (top.return) { path.push(top); top = top.return; }
            let current = top.stateNode?.current;
            for (let i = path.length - 1; i >= 0 && current; i--) {
                let child = current.child;
                while (child && child !== path[i] && child !== path[i].alternate) child = child.sibling;
                path[i] = current = child;
            }
            if (!current) continue;
            for (const fiber of path) {
                const pair = fiber.memoizedProps?.children;
                if (!Array.isArray(pair)) continue;
                const trigger = pair[0]?.props;
                const model = trigger?.children?.[0]?.props;
                if (model?.['data-testid'] !== 'model-selector-effort-group' ||
                    model['data-model-base'] !== marker.dataset.modelBase) continue;
                // The menu item's layout wrappers reuse the label as a child.
                // Only the native submenu trigger declares the selection state.
                if (typeof trigger.selected !== 'boolean') continue;
                if (!trigger.selected || trigger.disabled) break;
                const choices = pair[1]?.props?.children?.[1];
                const radio = choices?.props;
                const rows = radio?.children ?? choices;
                if (!Array.isArray(rows)) return null;
                const levels = [];
                for (const item of rows) {
                    const p = item?.props;
                    const label = p?.children?.props;
                    // Some choices require a second context-window selection.
                    // Leave those models to the native menu.
                    if (label?.['data-testid'] !== 'model-selector-effort-option' ||
                        typeof label.children !== 'string') return null;
                    if (p.disabled) continue;
                    const id = label['data-effort'];
                    levels.push({id, label: labels[label.children] || label.children,
                        active: radio ? radio.value === id : p.selected});
                }
                const index = levels.findIndex(level => level.active);
                if (index >= 0 && levels.length > 1) {
                    const model = modelSelection(path, levels[index].id);
                    if (model && levels.every(level => model.options.has(level.id)))
                        return {base: marker.dataset.modelBase, levels, index, model};
                }
                return null;
            }
        }
        return null;
    }

    const installed = Symbol.for('antigravity-i18n.effort-slider');
    function mount(panel) {
        if (panel[installed]) return;
        panel[installed] = true;
        let host, slider, value, scale, state, drag;
        let previousReveal = 0;
        function preview(fraction = slider.valueAsNumber / (state.levels.length - 1)) {
            const index = slider.valueAsNumber;
            value.textContent = state.levels[index].label;
            slider.setAttribute('aria-valuetext', value.textContent);
            host.style.setProperty('--position', (100 * fraction) + '%');
            // Dragging through the last interval uncovers the color continuously.
            // A click or keyboard step covers the same distance via the CSS transition.
            const last = state.levels.length - 1;
            const reveal = Math.min(1, Math.max(0, 1 - (1 - fraction) * last));
            if (reveal !== previousReveal) {
                host.toggleAttribute('data-receding', reveal < previousReveal);
                previousReveal = reveal;
            }
            host.style.setProperty('--wipe', (-100 * reveal) + '%');
            host.style.setProperty('--dots-opacity', String(1 - reveal));
            host.toggleAttribute('data-maximum', index === state.levels.length - 1);
        }
        function stopDrag() {
            if (!drag) return;
            const id = drag.id;
            drag = null;
            delete host.dataset.dragging;
            if (slider.hasPointerCapture(id)) slider.releasePointerCapture(id);
        }
        function followPointer(x) {
            const fraction = Math.min(1, Math.max(0, (x - drag.left) / drag.width));
            slider.valueAsNumber = Math.round(fraction * (state.levels.length - 1));
            preview(fraction);
        }
        function commit() {
            if (!state) return;
            const next = state.levels[slider.valueAsNumber];
            const current = selection(panel);
            if (current && current.base === state.base && current.levels[current.index].id === state.levels[state.index].id &&
                current.levels.some(level => level.id === next.id)) {
                preview(); // Snap even when the pointer ends inside the original detent.
                if (next.id !== current.levels[current.index].id) {
                    const option = current.model.options.get(next.id);
                    if (option && !option.disabled) {
                        current.model.select(option);
                        slider.focus({preventScroll:true});
                    }
                }
            } else {
                state = null;
            }
            sync();
        }
        function create() {
            host = document.createElement('div');
            host.dataset.agEffortSlider = '';
            const shadow = host.attachShadow({mode:'open'});
            shadow.innerHTML = `<style>
              :host {display:block; flex:none; font:inherit; color:inherit}
              .control {margin:4px 5px 0; padding:8px 5px 5px; border-top:1px solid color-mix(in srgb,currentColor 12%,transparent)}
              header {display:flex; align-items:baseline; gap:7px; line-height:17px}
              label {font-size:12px; font-weight:550}
              output {color:color-mix(in srgb,currentColor 70%,transparent); font-size:12px; font-weight:500}
              .rail {--handle:30px; --inset:calc(var(--handle) / 2 + 2px);
                position:relative; height:30px; margin-top:2px; direction:ltr}
              .track {--ink:light-dark(#101011,#b0b0b5); position:absolute; inset:5px 0; border-radius:99px; background:light-dark(#e1e1e3,#39393c)}
              .travel {position:absolute; inset:0 var(--inset); pointer-events:none}
              .fill {position:absolute; inset:0 calc(100% - var(--position) - var(--inset)) 0 calc(-1 * var(--inset));
                border-radius:99px; overflow:hidden; background:var(--ink); transition:right 140ms ease-out}
              .aurora {position:absolute; inset:0;
                background:linear-gradient(105deg,#2847bc,#704dff 38%,#af76ff 65%,#6155fb)}
              .fill::after {content:"";position:absolute;inset:0 auto 0 0;width:145%;
                background:linear-gradient(to right,var(--ink) 69%,transparent 100%);
                transform:translateX(var(--wipe,0%));transition:transform 960ms cubic-bezier(.3,.12,.47,.96)}
              .marks {position:absolute;inset:0;opacity:var(--dots-opacity,1);transition:opacity 400ms ease}
              .marks i {position:absolute;top:50%;translate:-50% -50%;width:3.5px;height:3.5px;border-radius:50%;
                background:light-dark(#87878b,#68686d);opacity:.7}
              .aurora::before,.aurora::after {content:"";position:absolute;inset:0}
              .aurora::before {background:
                radial-gradient(ellipse at 70% 45%,#d3aaffbb,transparent 40%),
                linear-gradient(110deg,#214deb 8%,#8153ff 49%,#8c78ff 70%,#4359f8);
                background-size:180% 165%; opacity:.85}
              .aurora::after {background:
                radial-gradient(circle at 11px 35%,#ffffffe6 1px,transparent 1.6px) 0 0 / 59px 100%,
                radial-gradient(circle at 38px 68%,#fff9 .8px,transparent 1.4px) 0 0 / 77px 100%,
                radial-gradient(circle at 23px 52%,#fff6 .7px,transparent 1.1px) 0 0 / 47px 100%}
              :host([data-maximum]) output {color:light-dark(#7642d1,#be9aff)}
              .handle {position:absolute; left:var(--position); top:2px; bottom:2px; width:var(--handle);
                translate:-50% 0; border-radius:99px; display:grid; place-content:center; gap:2px;
                background:#fff; box-shadow:0 0 0 1px #00000012,0 1px 3px #0003; transition:left 140ms ease-out}
              .handle::before,.handle::after {content:""; width:12px; height:2px; border-radius:2px; background:#c9c9cb}
              @media(prefers-reduced-motion:no-preference){
                :host([data-receding]) .fill::after {transition:transform 360ms ease-out}
                :host([data-maximum]) .aurora::before {animation:flow 3.8s ease-in-out infinite alternate}
                :host([data-maximum]) .aurora::after {animation:drift 4s linear infinite}
                @keyframes flow {from {background-position:0% 20%} to {background-position:100% 80%}}
                @keyframes drift {to {background-position:-59px 0,-77px 0,47px 0}}
              }
              :host([data-dragging]) .handle,:host([data-dragging]) .fill {transition:none}
              input {position:absolute; inset:0; width:100%; height:100%; margin:0; opacity:0; cursor:ew-resize; touch-action:none}
              .rail:has(input:focus-visible) .track {outline:1px solid currentColor; outline-offset:2px}
              @media(prefers-reduced-motion:reduce){.fill,.handle,.fill::after,.marks {transition:none}}
              @media(forced-colors:active){input {opacity:1} .track {display:none} :host output {color:CanvasText}}
            </style><div class="control"><header><label for="effort"></label><output for="effort"></output></header>
              <div class="rail"><div class="track" aria-hidden="true"><div class="travel"><div class="fill"><div class="aurora"></div></div><div class="marks"></div><div class="handle"></div></div></div>
              <input id="effort" type="range" min="0" step="1"></div></div>`;
            shadow.querySelector('label').textContent = labels['Thinking effort'];
            value = shadow.querySelector('output');
            scale = shadow.querySelector('.travel');
            slider = shadow.querySelector('input');
            for (const name of ['pointerdown','mousedown','click']) {
                host.addEventListener(name, event => event.stopPropagation());
            }
            slider.addEventListener('keydown', event => {
                if (['ArrowLeft','ArrowRight','ArrowUp','ArrowDown','Home','End','PageUp','PageDown'].includes(event.key))
                    event.stopPropagation();
            });
            slider.addEventListener('input', () => { if (state) preview(); });
            slider.addEventListener('change', commit);
            slider.addEventListener('pointerdown', event => {
                if (!state || drag || !event.isPrimary || event.button !== 0) return;
                const bounds = scale.getBoundingClientRect();
                if (!bounds.width) return;
                // Keep the native range's discrete keyboard/accessibility steps.
                // Pointer travel is continuous and commits only on release.
                event.preventDefault();
                slider.focus({preventScroll:true});
                slider.setPointerCapture(event.pointerId);
                drag = {id:event.pointerId, left:bounds.left, width:bounds.width};
                host.dataset.dragging = '';
                followPointer(event.clientX);
            });
            slider.addEventListener('pointermove', event => {
                if (drag?.id === event.pointerId) followPointer(event.clientX);
            });
            slider.addEventListener('pointerup', event => {
                if (drag?.id !== event.pointerId) return;
                followPointer(event.clientX);
                stopDrag();
                commit();
            });
            slider.addEventListener('lostpointercapture', () => {
                if (!drag) return;
                stopDrag();
                if (state) { slider.valueAsNumber = state.index; preview(); }
            });
        }
        function sync() {
            const list = Array.from(panel.children).find(child => child.querySelector(groupSelector));
            const current = list && selection(panel);
            if (!current) { stopDrag(); host?.remove(); state = null; return; }
            if (!host) create();
            if (list.nextElementSibling !== host) list.after(host);
            const changed = !state || state.base !== current.base || state.index !== current.index ||
                state.levels.length !== current.levels.length || state.levels.some((v,i) =>
                    v.id !== current.levels[i].id || v.label !== current.levels[i].label);
            state = current;
            if (changed) {
                stopDrag();
                slider.max = String(state.levels.length - 1);
                slider.value = String(state.index);
                const marks = scale.querySelector('.marks');
                if (marks.childElementCount !== state.levels.length) {
                    marks.replaceChildren(...state.levels.map((level, i) => {
                        const mark = document.createElement('i');
                        mark.style.left = (100 * i / (state.levels.length - 1)) + '%';
                        return mark;
                    }));
                }
                preview();
            }
        }
        sync();
        new MutationObserver(sync).observe(panel, {childList:true, subtree:true, characterData:true,
            attributes:true, attributeFilter:['aria-disabled','disabled','data-model-base','class']});
    }
    document.querySelectorAll(panelSelector).forEach(mount);
    new MutationObserver(records => {
        for (const record of records) {
            for (const node of record.addedNodes) {
                if (node.nodeType !== 1) continue;
                if (node.matches(panelSelector)) mount(node);
                else node.querySelectorAll(panelSelector).forEach(mount);
            }
        }
    }).observe(document, {childList:true, subtree:true});
}

(function installEffortSlider() {
    const labels = EFFORT_LABELS_PLACEHOLDER;
    if (typeof require === 'function') {
        require('electron').contextBridge?.executeInMainWorld?.({func:agMountEffortSliders,args:[labels]});
    } else {
        agMountEffortSliders(labels);
    }
})();
