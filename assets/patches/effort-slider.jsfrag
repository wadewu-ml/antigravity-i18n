// The desktop picker mounts its effort submenu only on hover. The selected
// group's React children already describe its native choices.
// Read that group in the renderer world; no Electron API is exposed to the page.
function agMountEffortSliders(labels) {
    const groupSelector = '[data-testid="model-selector-effort-group"]';
    const panelSelector = '[data-testid="model-selector-panel"]';
    function modelSelection(path, activeId) {
        // The picker passes a select-and-dismiss callback down to its submenu.
        // Its own input props still hold the model setter used by the composer.
        const context = path.map(node => node.memoizedProps?.value)
            .find(value => value?.effortIndex instanceof Map && value.selectedModel);
        if (!context) return null;
        const owner = path.map(node => node.memoizedProps).find(props =>
            props?.modelOptions === context.modelOptions && typeof props?.setIsOpen === 'function' &&
            typeof props.setSelectedModel === 'function' && props.setSelectedModel !== context.setSelectedModel);
        if (!owner || !owner.open || owner.lockedReason !== undefined) return null;
        const selected = context.selectedModel;
        for (const options of context.effortIndex.values()) {
            const active = options.get(activeId);
            if (active && (active === selected || (active.modelId && selected.modelId
                ? active.modelId === selected.modelId : active.label === selected.label))) {
                return {options, select:owner.setSelectedModel};
            }
        }
        return null;
    }
    function selection(panel) {
        for (const marker of panel.querySelectorAll(groupSelector)) {
            const key = Object.keys(marker).find(k => k.startsWith('__reactFiber$'));
            if (!key) continue;
            // Both alternates can have a return path to the same root after
            // React reuses children. Walk down the committed tree to read
            // today's choices and callbacks, including on a reused menu.
            const path = [];
            let top = marker[key];
            while (top.return) { path.push(top); top = top.return; }
            let current = top.stateNode?.current;
            for (let i = path.length - 1; i >= 0 && current; i--) {
                let child = current.child;
                while (child && child !== path[i] && child !== path[i].alternate) child = child.sibling;
                path[i] = current = child;
            }
            if (!current) continue;
            for (const fiber of path) {
                const pair = fiber.memoizedProps?.children;
                if (!Array.isArray(pair)) continue;
                const trigger = pair[0]?.props;
                const model = trigger?.children?.[0]?.props;
                if (model?.['data-testid'] !== 'model-selector-effort-group' ||
                    model['data-model-base'] !== marker.dataset.modelBase) continue;
                // The menu item's layout wrappers reuse the label as a child.
                // Only the native submenu trigger declares the selection state.
                if (typeof trigger.selected !== 'boolean') continue;
                if (!trigger.selected || trigger.disabled) break;
                const choices = pair[1]?.props?.children?.[1];
                const radio = choices?.props;
                const rows = radio?.children ?? choices;
                if (!Array.isArray(rows)) return null;
                const levels = [];
                for (const item of rows) {
                    const p = item?.props;
                    const label = p?.children?.props;
                    // Some choices require a second context-window selection.
                    // Leave those models to the native menu.
                    if (label?.['data-testid'] !== 'model-selector-effort-option' ||
                        typeof label.children !== 'string') return null;
                    if (p.disabled) continue;
                    const id = label['data-effort'];
                    levels.push({id, label: labels[label.children] || label.children,
                        active: radio ? radio.value === id : p.selected});
                }
                const index = levels.findIndex(level => level.active);
                if (index >= 0 && levels.length > 1) {
                    const model = modelSelection(path, levels[index].id);
                    if (model && levels.every(level => model.options.has(level.id)))
                        return {base: marker.dataset.modelBase, levels, index, model};
                }
                return null;
            }
        }
        return null;
    }

    const installed = Symbol.for('antigravity-i18n.effort-slider');
    function mount(panel) {
        if (panel[installed]) return;
        panel[installed] = true;
        let host, slider, value, state;
        function preview() {
            const i = slider.valueAsNumber;
            value.textContent = state.levels[i].label;
            slider.setAttribute('aria-valuetext', value.textContent);
            host.style.setProperty('--fill', (100 * i / (state.levels.length - 1)) + '%');
            host.shadowRoot.querySelectorAll('.scale i').forEach((dot, n) => dot.classList.toggle('filled', n <= i));
        }
        function create() {
            host = document.createElement('div');
            host.dataset.agEffortSlider = '';
            const shadow = host.attachShadow({mode:'open'});
            shadow.innerHTML = `<style>
              :host {display:block; color:inherit; font:inherit}
              .control {padding:8px 16px 9px; text-align:center}
              label {display:block; font-size:11px; line-height:15px; opacity:.65}
              output {display:block; font-size:16px; font-weight:600; line-height:21px}
              .rail {position:relative; height:28px; margin:4px auto 0; max-width:280px; direction:ltr}
              .track {position:absolute; inset:4px 0; border-radius:12px; overflow:hidden; background:color-mix(in srgb,currentColor 11%,transparent)}
              .scale {position:absolute; inset:0 10px; display:flex; align-items:center; justify-content:space-between}
              .scale::before {content:""; position:absolute; inset:0 auto 0 -10px; width:calc(var(--fill) + 10px); background:currentColor; opacity:.83}
              .scale i {position:relative; width:0; display:grid; place-content:center}
              .scale i::before {content:""; width:4px; height:4px; border-radius:50%; background:currentColor; opacity:.27}
              .scale i.filled::before {background:Canvas; opacity:.55}
              input {position:absolute; inset:0; width:100%; height:100%; margin:0; appearance:none; background:transparent; cursor:pointer}
              input::-webkit-slider-runnable-track {height:20px; background:transparent}
              input::-webkit-slider-thumb {appearance:none; width:20px; height:20px; border:1px solid #0002; border-radius:50%;
                background:#fff; box-shadow:0 1px 3px #0003}
              input:focus-visible {outline:2px solid currentColor; outline-offset:2px; border-radius:16px}
              @media(forced-colors:active){input {appearance:auto} .track {display:none}}
            </style><div class="control"><label for="effort"><span></span></label><output for="effort"></output><div class="rail"><div class="track" aria-hidden="true"><div class="scale"></div></div><input id="effort" type="range" min="0" step="1"></div></div>`;
            shadow.querySelector('span').textContent = labels['Thinking effort'];
            value = shadow.querySelector('output');
            slider = shadow.querySelector('input');
            slider.setAttribute('aria-label', labels['Thinking effort']);
            for (const name of ['pointerdown','mousedown','click']) {
                host.addEventListener(name, event => event.stopPropagation());
            }
            slider.addEventListener('keydown', event => {
                if (['ArrowLeft','ArrowRight','ArrowUp','ArrowDown','Home','End','PageUp','PageDown'].includes(event.key))
                    event.stopPropagation();
            });
            slider.addEventListener('input', preview);
            slider.addEventListener('change', () => {
                if (!state) return;
                const next = state.levels[slider.valueAsNumber];
                const current = selection(panel);
                if (current && current.base === state.base && current.levels[current.index].id === state.levels[state.index].id &&
                    next.id !== current.levels[current.index].id) {
                    const option = current.model.options.get(next.id);
                    if (option && !option.disabled && current.levels.some(level => level.id === next.id)) {
                        current.model.select(option);
                        // The composer focuses its editor after a model change.
                        slider.focus({preventScroll:true});
                    }
                }
                state = null;
                sync();
            });
        }
        function sync() {
            const footer = panel.lastElementChild;
            const usage = [...(footer?.querySelectorAll('span') || [])].find(span =>
                !span.children.length && ['View Usage', labels['View Usage']].includes(span.textContent.trim()));
            const row = usage?.closest('[role="menuitem"],button');
            const current = row && selection(panel);
            if (!current) { host?.remove(); state = null; return; }
            if (!host) create();
            if (host.nextElementSibling !== row) row.before(host);
            const changed = !state || state.base !== current.base || state.index !== current.index ||
                state.levels.length !== current.levels.length || state.levels.some((v,i) =>
                    v.id !== current.levels[i].id || v.label !== current.levels[i].label);
            state = current;
            if (changed) {
                slider.max = String(state.levels.length - 1);
                slider.value = String(state.index);
                host.shadowRoot.querySelector('.scale').replaceChildren(...state.levels.map(() => document.createElement('i')));
                preview();
            }
        }
        sync();
        new MutationObserver(sync).observe(panel, {childList:true, subtree:true, characterData:true,
            attributes:true, attributeFilter:['aria-disabled','disabled','data-model-base','class']});
    }
    document.querySelectorAll(panelSelector).forEach(mount);
    new MutationObserver(records => {
        for (const record of records) {
            for (const node of record.addedNodes) {
                if (node.nodeType !== 1) continue;
                if (node.matches(panelSelector)) mount(node);
                else node.querySelectorAll(panelSelector).forEach(mount);
            }
        }
    }).observe(document, {childList:true, subtree:true});
}

(function installEffortSlider() {
    const labels = EFFORT_LABELS_PLACEHOLDER;
    if (typeof require === 'function') {
        require('electron').contextBridge?.executeInMainWorld?.({func:agMountEffortSliders,args:[labels]});
    } else {
        agMountEffortSliders(labels);
    }
})();
